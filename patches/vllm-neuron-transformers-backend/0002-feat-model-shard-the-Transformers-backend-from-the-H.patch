-            raise NotImplementedError(
-                "The vLLM Neuron Transformers backend supports "
-                f"tensor_parallel_size=1 only for now, got {tp_size}."
-            )
         self.config = hf_config
         self.neuron_config = neuron_config
         # The dtype is read back from self.model rather than kept as an
@@ -283,6 +354,9 @@ class TransformersForCausalLM(nn.Module):
             cache_dir=cache_dir,
         )
         self.model.eval()
+        tp_group = get_tp_group()
+        if tp_group.world_size > 1:
+            _shard_for_tensor_parallel(self.model, tp_group)
 
     @torch.no_grad()
